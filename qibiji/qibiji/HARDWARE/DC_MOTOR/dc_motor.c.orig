#include "reg.h"
#include "main.h"
#include "dc_motor.h"
#include "timer.h"
#include "delay.h"
#include "mqtt.h"
#include "gprs.h"
#include "reg.h"
#include <stdbool.h>
u8 sys_moter_state = 3;
u8 sys_moter_state_old = 3;
u8 sys_local_remote = 1;
u8 sys_moter_dir = 0;

u8 openflag = 0, closeflag = 0;
u8 FLAG_OPENALL = 0, FLAG_CLOSEALL = 0;
u8 flag1s=0;

u8 flag500ms,flag20ms,flag300ms,tx3flag=1,flag1min;
u8 uploadflag=0;

extern Register armReg;

// IO初始化
void dcmotor_init(void)
{
  GPIO_InitTypeDef GPIO_InitStructure;

  RCC_APB2PeriphClockCmd(RCC_APB2Periph_GPIOD, ENABLE); 

  GPIO_InitStructure.GPIO_Pin = GPIO_Pin_1 | GPIO_Pin_3; // key_up / key_down / key_stop /key_switch
  GPIO_InitStructure.GPIO_Mode = GPIO_Mode_Out_PP;                            // 设置成浮空输入
  GPIO_InitStructure.GPIO_Speed = GPIO_Speed_50MHz;
  GPIO_Init(GPIOD, &GPIO_InitStructure);

	RLY_1H_OFF;
	RLY_2H_OFF;
}

// 电机开启
void dcmotor_up(void)
{
    RLY_2H_ON;   //先继电器2
	  delay_ms(5);
		RLY_1H_ON;
	
    FLAG_A=0;
    FLAG_B=0;
		sys_moter_dir=MOTOR_UP;
    gprs_send_datas(PUBLISH,0);
}
void dcmotor_down(void)
{
    RLY_2H_OFF;   //先继电器2
	  delay_ms(5);
		RLY_1H_ON;
	
    FLAG_A=0;
    FLAG_B=0;
		sys_moter_dir=MOTOR_DOWN;
    gprs_send_datas(PUBLISH,0);
}

// 电机停止
void dcmotor_stop(void)
{
		RLY_1H_OFF; //断继电器
    gprs_send_datas(PUBLISH,0);
}

//定时器
void TIM2_IRQHandler(void) // TIM2中断 10ms
{
    static u16 cnt = 5000;
    static u16 cnt_1 = 0,cnt_2 = 0;
    if (TIM_GetITStatus(TIM2, TIM_IT_Update) != RESET) // 检查指定的TIM中断发生与否:TIM 中断源
    {
        TIM_ClearITPendingBit(TIM2, TIM_IT_Update); // 清除TIMx的中断待处理位:TIM 中断源
			
        cnt++;
        if((cnt % 2) == 0)
        {
            flag20ms = 1;
        }
				
				if((cnt % 30) == 0)
				{
						flag300ms = 1;
				}
				
				if((cnt % 100) == 0)
				{
						cnt_2++;
					  if((cnt_2 >= armReg.reportT)&&(armReg.reportT))
						{
							cnt_2 = 0;
							uploadflag=1;
						}
				}
				
				if(cnt>=6000)
				{
					flag1min = 1;
					cnt = 0;
				}

        cnt_1++;
        if(cnt_1 >= 3)
        {
            if(sys_moter_state != MOTOR_STOP)
            {
                tx3flag = 1;
								cnt_1 = 0;
            }
						else
								cnt_1 = 3;   
        }
    }
}

//电机处理程序
void dcmotor_process()
{
	dcmotor_keycheck();
	dcmotor_ctrl();
}

//按键状态查询
void dcmotor_keycheck()
{
	u8 KeyVal=0;
	KeyVal = KEY_Scan();
	if()
	{
		 if (KEY_UP_VAL == 0 && armReg.motor_on_off == MOTOR_STOP && FLAG_OPENALL != 1) //上升按键
        {
            sys_moter_state = MOTOR_UP;
            armReg.motor_on_off = MOTOR_UP;          
            KeyLed_Ctl(0x01);
            return 1;
        }
        else if (KEY_DOWN_VAL == 0 && armReg.motor_on_off == MOTOR_STOP && FLAG_CLOSEALL != 1) //下降按键
        {
            sys_moter_state = MOTOR_DOWN;
            armReg.motor_on_off = MOTOR_DOWN;
            KeyLed_Ctl(0x02);
            return 2;
        }
        else if (KEY_STOP_VAL == 0) //停止按键
        {
						sys_moter_state = MOTOR_STOP;
            armReg.motor_on_off = MOTOR_STOP;
            KeyLed_Ctl(0x00);
            return 3;
        }
	}
}

// 电机控制
void dcmotor_ctrl()
{
    bool t1,t2,t3,t4; //布尔量赋值问题

    //判断电机停止条件
    t1 = FLAG_CLOSEALL==1 && (sys_moter_state == MOTOR_DOWN || sys_moter_state == MOTOR_RESET);//下限位
    t2 = FLAG_OPENALL==1 && (sys_moter_state==MOTOR_UP ||sys_moter_state == MOTOR_RESET);      //上限位
    t3 = sys_moter_state == MOTOR_UP && armReg.range_reality >= armReg.range_target;           //开启时给定目标
    t4 = sys_moter_state == MOTOR_DOWN && armReg.range_reality <= armReg.range_target && armReg.range_target!=0;//关闭时给定目标
	
	
    if(t1|| t2|| t3|| t4)
    {
        sys_moter_state = MOTOR_STOP;
    }
//-------------------------------------------------------------------------------------------------------
    //给定电机运行状态
    if (sys_moter_state_old != sys_moter_state)
    {
        switch (sys_moter_state)
        {
        case MOTOR_UP: // 上升
            dcmotor_up(); /* 开启电机 */
            break;
        case MOTOR_DOWN: // 下降
            dcmotor_down(); /* 开启电机 */
            break;
        case MOTOR_STOP: // 停止
            dcmotor_stop();
            break;
        case MOTOR_RESET: // 复位
            dcmotor_down();
            break;
        default:
            break;
        }
			
        sys_moter_state_old = sys_moter_state;
    }

    if(sys_moter_state!=MOTOR_STOP && flag1s==1)//flag1s 与 485 共用，此处不用清零
    {
        gprs_send_datas(PUBLISH,0);
    }
}
